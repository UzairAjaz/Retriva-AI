# Retriva environment configuration (copy to .env and edit).
# All values are optional; defaults keep local development working.

# ---------------------------------------------------------------------------
# Hardware: GPU / CPU auto-detection
# ---------------------------------------------------------------------------
# auto | cpu | cuda | cuda:0 | mps   (auto = CUDA -> MPS -> CPU)
RETRIVA_DEVICE=auto
# auto | float32 | float16 | bfloat16   (auto = bf16/fp16 on GPU, fp32 on CPU)
RETRIVA_TORCH_DTYPE=auto
# Optional separate device for the LLM (defaults to RETRIVA_DEVICE)
# LLM_DEVICE=cuda:0

# ---------------------------------------------------------------------------
# Models (resolved from the local HuggingFace cache)
# ---------------------------------------------------------------------------
HF_LOCAL_ONLY=true
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
LLM_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct

# ---------------------------------------------------------------------------
# Relational database: SQLite locally, PostgreSQL in production
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./retriva.db
# DATABASE_URL=postgresql+psycopg2://user:password@db-host:5432/retriva
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_ECHO=false

# ---------------------------------------------------------------------------
# Vector store: chroma (local/embedded) | pgvector (Postgres, cloud)
# ---------------------------------------------------------------------------
VECTOR_BACKEND=chroma
# PGVECTOR_URL defaults to DATABASE_URL when empty
# PGVECTOR_URL=postgresql+psycopg2://user:password@db-host:5432/retriva
PGVECTOR_TABLE=retriva_embeddings
PGVECTOR_MEMORY_TABLE=retriva_memory_embeddings
EMBEDDING_DIM=384

# ---------------------------------------------------------------------------
# Object storage for uploaded files: local | s3 | azure
# ---------------------------------------------------------------------------
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./uploads
# AWS
S3_BUCKET=
S3_PREFIX=uploads/
AWS_REGION=
# Azure
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=uploads

# ---------------------------------------------------------------------------
# Inference backend: local (in-process transformers) | remote (OpenAI-compatible)
# ---------------------------------------------------------------------------
LLM_BACKEND=local
# LLM_BASE_URL=http://vllm:8000/v1
# LLM_API_KEY=
LLM_REQUEST_TIMEOUT=300

# ---------------------------------------------------------------------------
# API / security
# ---------------------------------------------------------------------------
RETRIVA_SECRET_KEY=change-this-to-a-long-random-string
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# Retrieval / generation tuning
# ---------------------------------------------------------------------------
MAX_NEW_TOKENS=384
TOP_N_RETRIEVAL=12
TOP_N_RERANKED=6
MAX_CONTEXT_CHUNKS=6
CLARIFICATION_THRESHOLD=-2.0
RAG_CONFIDENCE_THRESHOLD=0.5
SHARE_KNOWLEDGE_ACROSS_USERS=true
